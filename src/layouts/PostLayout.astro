---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, author, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title={title} description={description}>
  <article>
    <h1 class="post-title">{title}</h1>

    <div class="post-meta">
      <time><FormattedDate date={pubDate} /></time>
      {updatedDate && (
        <span class="post-updated">
          Updated: <FormattedDate date={updatedDate} />
        </span>
      )}
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a class="tag" href={`${base}tags/${tag}/`}>#{tag}</a>
          ))}
        </div>
      )}
    </div>

    <div class="post-content">
      <slot />
    </div>
  </article>

  <style>
    article {
      max-width: 850px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .post-title {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .post-meta {
      margin-top: 0.5rem;
      opacity: 0.7;
      font-size: 0.9rem;
    }

    .post-updated {
      margin-left: 1rem;
    }

    .post-tags {
      margin-top: 0.5rem;
    }

    .tag {
      margin-right: 0.5rem;
    }

    .post-cover {
      margin: 2rem 0;
      text-align: center;
    }

    /* Post body */
    .post-content {
      margin-top: 3rem;
      line-height: 1.75;
    }

    .post-content h2 {
      margin-top: 3rem;
      margin-bottom: 1rem;
      font-size: 1.6rem;
    }

    .post-content h3 {
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    .post-content p {
      margin: 1.25rem 0;
    }

    /* Images inside post body */
    .post-content img {
      max-width: 100%;
      width: 650px;
      height: auto;
      display: block;
      margin: 2.5rem auto;
      border-radius: 6px;
    }

    .post-content figure {
      margin: 2.5rem auto;
      text-align: center;
    }

    .post-content figcaption {
      font-size: 0.85rem;
      opacity: 0.7;
      margin-top: 0.75rem;
    }

    /* Code blocks */
    .post-content pre,
    .post-content pre.astro-code {
      background: #0f0f0f !important;
      border: 1px solid #2a2a2a;
      border-radius: 8px;
      padding: 1.5rem;
      overflow-x: auto;
      margin: 2rem 0;
    }

    .post-content :not(pre) > code {
      background: rgba(255, 255, 255, 0.08);
      padding: 0.15em 0.4em;
      border-radius: 4px;
      font-size: 0.88em;
    }

    .post-content pre code {
      background: none;
      font-family: monospace;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
