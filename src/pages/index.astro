---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPinnedRepos, getGitHubStats, getContributionGraphUrl } from '../lib/github';

const GITHUB_USERNAME = 'pri1712';

const repos = await getPinnedRepos(GITHUB_USERNAME);
const stats = await getGitHubStats(GITHUB_USERNAME);
const contributionGraphUrl = getContributionGraphUrl(GITHUB_USERNAME);
---

<BaseLayout title="Priyanshu">
  <main class="container">

    <!-- Intro -->
    <section class="intro">
      <h1>Priyanshu Soni</h1>
     <p class="subtitle">
      Hi! Welcome to this little corner of the internet that I call home. 
      I post about stuff that I find cool or sometimes just because I have nothing else to do.
      </p>

    <p class="subtitle">
      I am currently working as a Software Engineer at Flipkart, building observability solutions at scale. 
      I am trying to get into OSS and enjoy reading about distributed systems, especially databases/storage systems.
    </p>
    </section>

    <!-- Skills -->
    <section>
      <h2>Skills</h2>
      <p class="skills">
        {stats.topLanguages.join(' · ') || 'Loading...'}
      </p>
    </section>

    <!-- Projects -->
    <section>
      <h2>Projects</h2>

      <div class="repo-list">
        {repos.map((repo) => (
          <article class="repo-item">
            <div class="repo-header">
              <h3>{repo.name}</h3>
              {repo.primaryLanguage && (
                <span class="lang">
                  {repo.primaryLanguage.name}
                </span>
              )}
            </div>

            <p class="desc">
              {repo.description || 'No description provided'}
            </p>

            <div class="meta">
              <span>★ {repo.stargazerCount}</span>
              <span>Forks: {repo.forkCount}</span>
              <span>
                Updated {new Date(repo.pushedAt).toLocaleDateString()}
              </span>
            </div>

            <div class="links">
              <a href={repo.url} target="_blank">Source</a>
              {repo.homepageUrl && (
                <a href={repo.homepageUrl} target="_blank">Live</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Activity -->
    <section>
      <h2>Activity</h2>
      <img
        src={contributionGraphUrl}
        alt="GitHub Contribution Graph"
        loading="lazy"
      />
    </section>

  </main>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.3rem;
  }

  .subtitle {
    color: var(--gray);
    margin-bottom: 1rem;
  }

  .meta {
    color: var(--gray);
    font-size: 0.9rem;
  }

  .skills {
    color: var(--fg);
  }

  .repo-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .subtitle {
  margin-bottom: 1rem;
  }

  .repo-item {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1rem;
  }

  .repo-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .lang {
    font-size: 0.8rem;
    color: var(--gray);
  }

  .desc {
    margin: 0.5rem 0;
    color: var(--fg);
    opacity: 0.85;
  }

  .links a {
    margin-right: 1rem;
    font-size: 0.9rem;
  }

  img {
    width: 100%;
    margin-top: 1rem;
  }
</style>