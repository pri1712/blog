---
// src/pages/man.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="man priyanshu">
  <div class="man-page">
    <pre class="man-header">
PRIYANSHU(1)                   User Commands                  PRIYANSHU(1)
    </pre>

    <section class="man-section">
      <h2>NAME</h2>
      <p class="indent">
        priyanshu - distributed systems engineer, latency adversary
      </p>
    </section>

    <section class="man-section">
      <h2>SYNOPSIS</h2>
      <p class="indent">
        <strong>priyanshu</strong> [--role=SDE] [--target=BACKEND|INFRA]
        <br/>
        <strong>priyanshu</strong> start --component=raft-consensus --lang=go
      </p>
    </section>

    <section class="man-section">
      <h2>DESCRIPTION</h2>
      <p class="indent">
        Software Development Engineer at Flipkart working on next-gen logging and tracing
        infrastructure at large scale. Specializes in distributed systems,
        high-throughput data pipelines, and aggressive performance optimization.
      </p>
      <p class="indent">
        Demonstrates linearizable behavior under high load. Known to build consensus 
        systems from scratch, slash P99 latencies by 95%, and process 200k+ events/sec 
        in production environments. Native execution targets include Go, Rust, Java, and C++.
      </p>
    </section>

    <section class="man-section">
      <h2>OPTIONS</h2>
      <dl class="man-options">
        <dt>-l, --languages</dt>
        <dd>C/C++, Rust, Golang, Java, Python, Bash, SQL</dd>

        <dt>-f, --frameworks</dt>
        <dd>Docker, Kubernetes, Apache Pinot, Kafka</dd>

        <dt>-d, --databases</dt>
        <dd>Neo4j, PostgreSQL, custom storage backends</dd>

        <dt>-i, --infrastructure</dt>
        <dd>Linux (Arch/Debian), Git, Grafana, Distributed Tracing</dd>

        <dt>--capabilities</dt>
        <dd>Distributed Systems, System Architecture, Backend Development, Performance Engineering</dd>

        <dt>-t, --toolchain</dt>
        <dd>Custom profilers, Locust (Load testing), Observability stacks</dd>
      </dl>
    </section>

    <section class="man-section">
      <h2>EXPERIENCE</h2>
      
      <div class="job">
        <h3>Software Development Engineer 1 - Flipkart</h3>
        <p class="job-date">July 2025 - Present | Bengaluru, Karnataka</p>
        <ul>
          <li>Helped architect and also implemented core components of Flipkart's large-scale logging platform.</li>
          <li>Drove platform adoption through targeted UX improvements and developer tooling.</li>
          <li>Built high-throughput Kafka ingestion pipeline from scratch (sustains 200k events/sec).</li>
          <li>Slashed P99 query latency by 95% via aggressive batching, caching, and query optimization.</li>
          <li>Benchmarked and evaluated database backends, schemas, and encodings for production deployment.</li>
        </ul>
      </div>

      <div class="job">
        <h3>Software Development Engineer Intern - Flipkart</h3>
        <p class="job-date">January 2025 - July 2025 | Bengaluru, Karnataka</p>
        <ul>
          <li>Built observability infrastructure for Java microservices using a custom bytecode agent.</li>
          <li>Refactored internal logging framework to resolve dependency conflicts and improve extensibility.</li>
          <li>Performed distributed load testing with Locust to benchmark and minimize agent overhead.</li>
          <li>Quantified and resolved performance regressions in real-world application deployments.</li>
        </ul>
      </div>

      <div class="job">
        <h3>Research Intern - Indian Institute of Science</h3>
        <p class="job-date">May 2024 - July 2024 | Bengaluru, Karnataka</p>
        <ul>
          <li>Integrated ResNet model into an existing pipeline, improving overall accuracy by 3.7%.</li>
          <li>Fine-tuned embedding extractors on 100+ hours of speaker verification data.</li>
          <li>Enhanced speaker diarization pipeline accuracy through targeted model optimization.</li>
        </ul>
      </div>
    </section>

    <section class="man-section">
      <h2>PROJECTS</h2>
      
      <div class="project">
        <h3>Distributed Key-Value Store</h3>
        <ul>
          <li>Engineered a distributed consensus engine in pure Go (zero external libraries).</li>
          <li>Implemented the Raft protocol: Leader Election, Log Replication, and strict fault tolerance.</li>
          <li>Built Log Compaction and Snapshotting mechanics for instant crash recovery.</li>
          <li>Solved network partitions using robust RPC timeouts, heartbeats, and term verification.</li>
          <li>Achieved linearizable consistency across physically distributed nodes.</li>
        </ul>
      </div>

      <div class="project">
        <h3>Redstone: High performance ML cache</h3>
        <ul>
          <li>Building a highly scalable ML cache with native tensor support.</li>
          <li>Achieved 3k ops/sec for 1-2MB tensor workloads.</li>
          <li>Architected the overall system from scratch.</li>
          <li>Implemented zero copy transport, and an overall cache that is comparable to Redis/Memcached for larger sized workloads.</li>
        </ul>
      </div>


    </section>

    <section class="man-section">
      <h2>EDUCATION</h2>
      <p class="indent">
        <strong>B.Tech in Electronics and Communication Engineering</strong>
        <br/>
        National Institute of Technology Karnataka, Surathkal
        <br/>
        December 2021 - May 2025
        <br/>
        Focus: Computer Architecture, Systems and avoiding the frontend.
      </p>
    </section>

    <section class="man-section">
        <h2>TELEMETRY</h2>
      <pre class="metrics-display">
┌─────────────────────────────────────────────┐
│ RUNTIME METRICS                             │
├─────────────────────────────────────────────┤
│ Events/sec Processed:   200,000+            │
│ Petabytes Managed:      Multiple            │
│ P99 Latency Delta:      -95%                │
│ Consensus State:        Linearizable        │
│ Panic Recovery:         Enabled             │
│ Coffee->Code Ratio:     1:1 (Strict)        │
└─────────────────────────────────────────────┘
      </pre>
    </section>

    <section class="man-section">
      <h2>AVAILABILITY</h2>
      <p class="indent">
        Always polling for interesting problems involving 
        distributed systems, database storage engines, consensus algorithms, and architecture 
        that operates at massive scale.
      </p>
    </section>

    <section class="man-section">
      <h2>EXIT STATUS</h2>
      <dl class="man-options">
        <dt>0</dt>
        <dd>Execution successful. All systems nominal.</dd>

        <dt>1</dt>
        <dd>Latency exceeded P99 threshold.</dd>

        <dt>137</dt>
        <dd>OOM (Out of Coffee) Killer invoked.</dd>

        <dt>255</dt>
        <dd>Network partition detected. Split-brain imminent.</dd>
      </dl>
    </section>

    <section class="man-section">
      <h2>SEE ALSO</h2>
      <p class="indent">
        <a href="/">home(1)</a>,
        <a href="/posts">blog(1)</a>,
        <a href="https://github.com/pri1712">github(1)</a>,
        <a href="https://linkedin.com/in/priyanshu1712">linkedin(1)</a>,
        <a href="mailto:priyanshu17@outlook.com">email(1)</a>
      </p>
    </section>

    <section class="man-section">
      <h2>BUGS</h2>
      <p class="indent">
        Occasionally rewrites perfectly good Go code in Rust for "zero-cost abstractions". 
        Highly susceptible to falling down database internals rabbit holes. 
        <br/><br/>
        Report issues and segfaults to: <a href="mailto:priyanshu17@outlook.com">priyanshu17@outlook.com</a>
      </p>
    </section>

    <pre class="man-footer">
Linux (Arch)                 2026-01-18                  PRIYANSHU(1)
    </pre>
  </div>
</BaseLayout>

<style>
  .man-page {
    max-width: 850px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    font-family: 'Fira Code', monospace;
    line-height: 1.6;
  }

  .man-header,
  .man-footer {
    text-align: center;
    color: var(--gray);
    margin: 2rem 0;
    opacity: 0.7;
  }

  .man-section {
    margin: 3rem 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    position: relative;
  }

  /* Terminal Tab effect for each section */
  .man-section::before {
    position: absolute;
    top: -12px;
    left: 10px;
    background: var(--bg-hard);
    padding: 0 10px;
    color: var(--gray);
    font-size: 0.75rem;
    font-weight: normal;
  }

  .man-section:nth-of-type(1)::before { content: "name.txt"; }
  .man-section:nth-of-type(2)::before { content: "synopsis.sh"; }
  .man-section:nth-of-type(3)::before { content: "description.md"; }
  .man-section:nth-of-type(4)::before { content: "options.conf"; }
  .man-section:nth-of-type(5)::before { content: "experience.log"; }
  .man-section:nth-of-type(6)::before { content: "projects.json"; }
  .man-section:nth-of-type(7)::before { content: "education.yaml"; }
  .man-section:nth-of-type(8)::before { content: "telemetry.csv"; }
  .man-section:nth-of-type(9)::before { content: "availability.md"; }
  .man-section:nth-of-type(10)::before { content: "exit_status.c"; }
  .man-section:nth-of-type(11)::before { content: "see_also.links"; }
  .man-section:nth-of-type(12)::before { content: "bugs.report"; }

  .man-section h2 {
    color: var(--yellow);
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }

  .man-section h2::before {
    content: 'λ ';
    color: var(--green);
  }

  .man-section h3 {
    color: var(--orange);
    font-size: 1rem;
    margin: 1.5rem 0 0.5rem 0;
    font-weight: 600;
  }

  .indent {
    margin-left: 1.5rem;
    color: var(--fg);
    opacity: 0.9;
  }

  .man-options {
    margin-left: 1.5rem;
  }

  .man-options dt {
    color: var(--green);
    font-weight: 700;
    margin-top: 1rem;
  }

  .man-options dt::before {
    content: ':: ';
    color: var(--green);
  }

  .man-options dd {
    margin-left: 2rem;
    color: var(--gray);
    margin-top: 0.25rem;
  }

  .job,
  .project {
    margin: 2rem 0 2rem 1.5rem;
    padding: 1rem;
    border-left: 2px solid var(--border);
  }

  .job:hover,
  .project:hover {
    border-left-color: var(--gray);
  }

  .job-date {
    color: var(--gray);
    font-size: 0.85rem;
    margin: 0.25rem 0 0.75rem 0;
    opacity: 0.8;
  }

  .man-section ul {
    margin-left: 2rem;
    list-style-type: none;
  }

  .man-section li {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .man-section li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--green);
  }

  .metrics-display {
    margin: 1rem 0;
    padding: 1rem;
    color: var(--green);
    font-size: 0.85rem;
    line-height: 1.4;
    border: 1px solid var(--border);
    background: var(--bg-hard);
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    display: inline-block;
    white-space: pre;
    border-radius: 4px;
  }

  .man-section a {
    color: var(--aqua);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s ease;
  }

  .man-section a:hover {
    border-bottom-color: var(--green);
    color: var(--green);
  }

  @media (max-width: 768px) {
    .man-page {
      padding: 2rem 1rem;
    }

    .man-section {
      padding: 1rem;
    }

    .indent,
    .man-options,
    .job,
    .project {
      margin-left: 0.5rem;
    }

    .man-section ul {
      margin-left: 1rem;
    }

    .metrics-display {
      font-size: 0.7rem;
    }
  }
</style>