---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Posts">
  <main class="container">

    <section>
      <h1>Posts</h1>
      <p class="subtitle">
        Writing on systems, infrastructure, and things I find interesting.
      </p>
    </section>

    <section>
      {posts.length === 0 ? (
        <p class="meta">No posts yet.</p>
      ) : (
        <ul class="list">
          {posts.map((post) => (
            <li class="list-item">
              <div class="row">
                <a href={`/posts/${post.slug}`} class="title">
                  {post.data.title}
                </a>

                <time class="meta">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
              </div>

              <p class="desc">
                {post.data.description}
              </p>
            </li>
          ))}
        </ul>
      )}
    </section>

  </main>
</BaseLayout>

<style>
 .container {
  max-width: 720px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

/* Header */
h1 {
  font-size: 2rem;
  margin-bottom: 0.25rem;
}

.subtitle {
  color: var(--gray);
  margin-bottom: 2rem;
}

/* List */
.list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.list-item {
  margin-bottom: 2.5rem;
}

/* Title row */
.row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
}

/* Title */
.title {
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--fg);
  text-decoration: none;
  line-height: 1.4;
}

.title:hover {
  text-decoration: underline;
}

/* Date */
.meta {
  font-size: 0.8rem;
  color: var(--gray);
  white-space: nowrap;
}

/* Description */
.desc {
  margin-top: 0.4rem;
  color: var(--gray);
  font-size: 0.95rem;
  line-height: 1.6;
}

/* Add subtle separation */
.list-item:not(:last-child) {
  border-bottom: 1px solid var(--border);
  padding-bottom: 1.5rem;
}
</style>